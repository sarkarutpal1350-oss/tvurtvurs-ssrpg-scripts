var dist
dist = foe.distance

var CanActive
CanActive = item.CanActivate()

var speAct
speAct = item.CanActivate

var pot
?loc.begin
 pot = 1

var fo
fo = foe

var foes
foes = foe.count

var CD
CD = item.GetCooldown

var Dbuff
Dbuff = foe.debuffs.string

var ShHeal
ShHeal = hp <= maxhp * 0.8

var p3fre
?loc.stars >= 10
 p3fre = 1
:
 p3fre = 0

var type1
var type2
var addon1
var addon2
var element1

var fs
fs = foe.state

var fdt
fdt = foe.debuffs.GetTime

var blade_req
blade_req = 5

var d

