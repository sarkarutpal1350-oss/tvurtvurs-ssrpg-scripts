<*weapons*>
\*********/

/*¡IMPORTANT! CHANGE THESE TO YOUR WEAPONS*/

func heal()
 equipR vigor sword +17
 ?fo=phase2
  equipL @element2@
 :
  equipL vigor sword +16
 ?dist > 5
  dabash(bash)
  ?dabash(bash)
   dabash(dash)

func dabash(w)
 ?CD(w) <= 0
  equipL sword
  equipR @w@
 :
  return true

func regular()
 ?CD(＂quarterstaff＂) <= 0 & !ai.paused
  staff()
 :
  equipL trisk
  ?pickup.distance <= 6
   equipR star
  :
   ?buffs.GetCount(＂lucky_mult＂) >= 1
    equipR cult
   :
    equipR comp

func freezedys()
 equipL ice wand +13
 moonright(＂comp＂)

