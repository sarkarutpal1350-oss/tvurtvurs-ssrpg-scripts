<*dodge*>
\*******/

?(foe.state = 115 & foe.time >= 60
^ & CD(＂mind＂) <= 0) | (foe.time >= 55
^ & foe.state = 32 & CD(＂mind＂) <= 0
^ & foe.damage = 1)
 equipL mind
 equipR comp
 d = 1
:
 d = 0
